# Optional: use only when the browser can reach the FastAPI service directly.
# By default, the frontend uses its same-origin /api/predict proxy.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Internal URL used by Next.js API routes to reach FastAPI.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

